# Base URL of the backend in ../backend. Metro inlines EXPO_PUBLIC_* at bundle
# time, so restart the dev server (npx expo start -c) after changing this.
#
# localhost works everywhere the JS runs on the same machine as the API (iOS
# simulator, web) and on Android once the port is forwarded:
#
#   adb reverse tcp:4000 tcp:4000
#
# Run that once per connected device/emulator, after `adb devices` lists it.
EXPO_PUBLIC_API_URL=http://localhost:4000
