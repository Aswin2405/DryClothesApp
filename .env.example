# Base URL of the backend. Metro inlines EXPO_PUBLIC_* at bundle time, so restart
# the dev server (npx expo start -c) after changing this.
#
# Deployed (Render) — works on every platform, simulator or real device, with no
# port forwarding, and is the only option that works in a release build:
EXPO_PUBLIC_API_URL=https://dryclothesapp-backend.onrender.com

# Local backend instead (cd ../backend && npm run dev). On Android you also need
# `adb reverse tcp:4000 tcp:4000`, and cleartext HTTP only works in debug builds.
# EXPO_PUBLIC_API_URL=http://localhost:4000
