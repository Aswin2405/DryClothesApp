{
  "expo": {
    "name": "DryClothesApp",
    "slug": "DryClothesApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-2.png",
    "scheme": "dryclothesapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo-2.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Used to show real-time weather and drying conditions at your location.",
        "NSLocationAlwaysUsageDescription": "Used to update rain alerts in the background.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Used to update rain alerts in the background.",
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "backgroundModes": [
        "fetch",
        "remote-notification"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-2.png",
        "backgroundImage": "./assets/images/logo-2.png",
        "monochromeImage": "./assets/images/logo-2.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ],
      "package": "com.aswin2405.DryClothesApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-screen.png",
          "resizeMode": "cover",
          "android": {
            "image": "./assets/images/splash-screen.png",
            "resizeMode": "cover"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow DryClothesApp to use your location to show rain alerts.",
          "locationAlwaysPermission": "Allow DryClothesApp to check weather in the background.",
          "locationWhenInUsePermission": "Allow DryClothesApp to use your location for weather data.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notifications.png",
          "color": "#07422A",
          "defaultChannel": "rain-alerts"
        }
      ],
      "expo-background-fetch",
      "expo-task-manager"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90c38135-6857-4e45-b8b0-18fe8caa254d"
      }
    }
  }
}
